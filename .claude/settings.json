{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:partner.extendly.com)",
      "Edit(/niche-offers/**)",
      "Edit(/offer-drafts/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/sync-fitd-builder.sh", "--auto"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
